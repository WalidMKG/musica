<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="800.0" prefWidth="250.0" spacing="20.0" stylesheets="@../../css/global.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="univr.musica.controller.User.UserController">
     <HBox fx:id="home_icon" alignment="CENTER" onMouseClicked="#go_home" prefHeight="50.0" prefWidth="200.0" spacing="20.0">
         <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
             <Image url="@../../img/ic_home.png" />
         </ImageView>
         <Label prefHeight="21.0" prefWidth="101.0" text="Home" textFill="WHITE">
             <font>
                 <Font name="System Bold" size="18.0" />
             </font>
         </Label>
         <styleClass>
             <String fx:value="selected" />
             <String fx:value="sidebar-item" />
         </styleClass>
         <cursor>
             <Cursor fx:constant="HAND" />
         </cursor>
     </HBox>
     <HBox fx:id="go_to_search" alignment="CENTER" onMouseClicked="#go_to_search" prefHeight="50.0" prefWidth="200.0" spacing="20.0">
         <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
             <Image url="@../../img/ic_search.png" />
         </ImageView>
         <Label prefHeight="21.0" prefWidth="101.0" text="Search" textFill="#a1a1a1">
             <font>
                 <Font name="System Bold" size="18.0" />
             </font>
         </Label>
         <cursor>
             <Cursor fx:constant="HAND" />
         </cursor>
     </HBox>
    <Pane prefHeight="12.0" prefWidth="235.0" VBox.vgrow="ALWAYS" />
    <HBox fx:id="upload_btn" alignment="CENTER" onMouseClicked="#open_load_page" prefHeight="50.0" prefWidth="200.0" spacing="20.0">
        <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
            <Image url="@../../img/ic_upload.png" />
        </ImageView>
        <Label prefHeight="21.0" prefWidth="101.0" text="Upload" textFill="#a1a1a1">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <cursor>
            <Cursor fx:constant="HAND" />
        </cursor>
    </HBox>
    <HBox fx:id="logout_btn" alignment="CENTER" onMouseClicked="#logout_request" prefHeight="50.0" prefWidth="200.0" spacing="20.0">
        <children>
            <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../../img/ic_exit.png" />
                </image>
            </ImageView>
            <Label prefHeight="21.0" prefWidth="101.0" text="Logout" textFill="#a1a1a1">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
        </children>
        <cursor>
            <Cursor fx:constant="HAND" />
        </cursor>
    </HBox>
</VBox>
