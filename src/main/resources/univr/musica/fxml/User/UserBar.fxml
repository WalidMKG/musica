<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="800.0" prefWidth="250.0" spacing="20.0" stylesheets="@../../css/global.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="univr.musica.controller.User.UserController">
    <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
        <VBox.margin>
            <Insets left="20.0" top="20.0" />
        </VBox.margin>
        <Image url="@../../img/ic_more.png" />
    </ImageView>
    <VBox prefHeight="182.0" prefWidth="235.0" spacing="10.0">
        <HBox fx:id="home_icon" alignment="CENTER" onMouseClicked="#go_home" prefHeight="50.0" prefWidth="200.0" spacing="20.0">
            <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@../../img/ic_home.png" />
            </ImageView>
            <Label prefHeight="21.0" prefWidth="101.0" text="Home" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
         <styleClass>
            <String fx:value="selected" />
            <String fx:value="sidebar-item" />
         </styleClass>
        </HBox>
        <HBox fx:id="go_to_profile" alignment="CENTER" onMouseClicked="#go_to_profile" prefHeight="50.0" prefWidth="200.0" spacing="20.0">
            <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@../../img/ic_browse.png" />
            </ImageView>
            <Label prefHeight="21.0" prefWidth="101.0" text="Profile" textFill="#a1a1a1">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
        </HBox>
        <HBox fx:id="go_to_search" alignment="CENTER" onMouseClicked="#go_to_search" prefHeight="50.0" prefWidth="200.0" spacing="20.0">
            <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@../../img/ic_radio.png" />
            </ImageView>
            <Label prefHeight="21.0" prefWidth="101.0" text="Search" textFill="#a1a1a1">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
        </HBox>
    </VBox>
    <Pane prefHeight="12.0" prefWidth="235.0" VBox.vgrow="ALWAYS" />
    <HBox fx:id="upload_btn" alignment="CENTER" onMouseClicked="#open_load_page" prefHeight="50.0" prefWidth="200.0" spacing="20.0">
        <ImageView fitHeight="35.0" fitWidth="35.0" pickOnBounds="true" preserveRatio="true">
            <Image url="@../../img/ic_add.png" />
        </ImageView>
        <Label prefHeight="40.0" prefWidth="120.0" text="Upload" textFill="#a1a1a1">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
    </HBox>
   <HBox fx:id="logout_btn" alignment="CENTER" onMouseClicked="#logout_request" prefHeight="50.0" prefWidth="200.0" spacing="20.0">
      <children>
         <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@../../img/ic_radio.png" />
            </image>
         </ImageView>
         <Label prefHeight="21.0" prefWidth="101.0" text="LOGOUT" textFill="#a1a1a1">
            <font>
               <Font name="System Bold" size="18.0" />
            </font>
         </Label>
      </children>
   </HBox>
</VBox>
